# Build artifacts
/target/
/dist/
/.lab-runs/

# Binaries staged into the container build context by the release workflow
/docker/release/koi-*

# Generated from the exact native artifacts immediately before npm pack/publish
/packages/npm/release-manifest.json
/packages/npm/*.tgz

# Python build artifacts (packages/python)
__pycache__/
*.pyc
*.egg-info/

# Cargo lock is committed for binaries
# Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Environment / secrets
.env
*.pem
# ...except public conformance fixtures (CSRs carry public material only)
!crates/koi-certmesh/tests/fixtures/*.pem
*.key

# Debug
*.pdb
