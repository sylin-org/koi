# Maintainer: Sylin <hello@sylin.org>

pkgname=koi
pkgver=1.0.0_pre0_git20260904
pkgrel=2
pkgdesc="Local connectivity substrate for discovering, trusting, and connecting a LAN"
url="https://github.com/sylin-org/koi"
arch="x86_64 aarch64"
license="MIT OR Apache-2.0"
makedepends="
	build-base
	cargo
	git
	rust
	"
subpackages="$pkgname-openrc::noarch $pkgname-doc"
install="$pkgname-openrc.post-install $pkgname-openrc.pre-deinstall"
# Cargo fetches the locked dependency graph during local package builds.
options="net"
_commit=e64b50e7146d2aff4fe0546763833098432faae8
source="$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

build() {
	CARGO_TARGET_DIR="$srcdir/target" \
		cargo build --locked --release -p koi-net
}

check() {
	CARGO_TARGET_DIR="$srcdir/target" \
		cargo test --locked -p koi-net platform::recipes
}

package() {
	install -Dm755 "$srcdir/target/release/koi" \
		"$pkgdir/usr/bin/koi"

	install -d "$pkgdir/etc/init.d"
	sed 's|{{BIN}}|/usr/bin/koi|g' \
		crates/koi/src/platform/recipes/templates/koi-openrc.initd \
		>"$pkgdir/etc/init.d/koi"
	chmod 755 "$pkgdir/etc/init.d/koi"
	install -Dm644 crates/koi/src/platform/recipes/templates/koi.logrotate \
		"$pkgdir/etc/logrotate.d/koi"

	install -Dm644 README.md "$pkgdir/usr/share/doc/koi/README.md"
	install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/koi/LICENSE-APACHE"
	install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/koi/LICENSE-MIT"
}

openrc() {
	pkgdesc="$pkgdesc (OpenRC service)"
	depends="$pkgname=$pkgver-r$pkgrel openrc logrotate"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	amove etc/init.d/koi
	amove etc/logrotate.d/koi
}

sha512sums="
9f299084d9a63114aaeac48617cccbc81771cea55ed31f4181b322973c7e117e1e00dc305e54334ff7cf50566e2e2b1f7f733a96733fa14221b18493cad03ace  koi-e64b50e7146d2aff4fe0546763833098432faae8.tar.gz
"
