    "@sylin-org/koi-darwin-x64": "1.0.0-rc.2",
    "@sylin-org/koi-linux-arm64": "1.0.0-rc.2",
    "@sylin-org/koi-linux-x64": "1.0.0-rc.2",
    "@sylin-org/koi-win32-arm64": "1.0.0-rc.2",
    "@sylin-org/koi-win32-x64": "1.0.0-rc.2"
